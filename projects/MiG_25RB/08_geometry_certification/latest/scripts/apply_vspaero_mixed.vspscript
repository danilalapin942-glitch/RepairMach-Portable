void main()
{
    ClearVSPModel();
    ReadVSPFile( "C:/Users/admin/.codex/.chatgpt-projects/g-p-6910508be2a081919b9cb5881a96c92b/acceptance/geometry_certification_2026-09-09/20260909_092023_MiG_25RB_final_MiG-25RB_VSPAero_v1/frozen_master.vsp3" );
    Update();

    SetSetFlag( "UPQJQXHTKG", 4, false );
    SetSetFlag( "UPQJQXHTKG", 5, false );
    if ( GetSetFlag( "UPQJQXHTKG", 4 ) )
    {
        Print( "REPAIRMACH_APPLY_ABORT=SET_CLEAR_NOT_APPLIED;GEOM_ID=UPQJQXHTKG;SET=4" );
        return;
    }
    if ( GetSetFlag( "UPQJQXHTKG", 5 ) )
    {
        Print( "REPAIRMACH_APPLY_ABORT=SET_CLEAR_NOT_APPLIED;GEOM_ID=UPQJQXHTKG;SET=5" );
        return;
    }
    Print( "APPLIED;ACTION=clear_sets;GEOM_ID=UPQJQXHTKG" );

    Update();
    int apply_error_count = GetNumTotalErrors();
    while ( GetNumTotalErrors() > 0 )
    {
        ErrorObj err = PopLastError();
        Print( "OPENVSP_ERROR=" + err.GetErrorString() );
    }
    if ( apply_error_count > 0 )
    {
        Print( "REPAIRMACH_APPLY_ABORT=OPENVSP_ERRORS_BEFORE_WRITE" );
        return;
    }
    WriteVSPFile( "C:/Users/admin/.codex/.chatgpt-projects/g-p-6910508be2a081919b9cb5881a96c92b/acceptance/geometry_certification_2026-09-09/20260909_092023_MiG_25RB_final_MiG-25RB_VSPAero_v1/vspaero/mixed/model.vsp3", 0 );
    int write_error_count = GetNumTotalErrors();
    while ( GetNumTotalErrors() > 0 )
    {
        ErrorObj err = PopLastError();
        Print( "OPENVSP_ERROR=" + err.GetErrorString() );
    }
    if ( write_error_count > 0 )
    {
        Print( "REPAIRMACH_APPLY_ABORT=OPENVSP_ERRORS_DURING_WRITE" );
        return;
    }
    Print( "REPAIRMACH_APPLY_OK=1" );
}
